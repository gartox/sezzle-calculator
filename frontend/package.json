{
  "name": "sezzle-calculator-frontend",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "generate:api": "openapi-typescript ../backend/internal/httpapi/openapi.yaml -o src/api/schema.d.ts",
    "test": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "format": "prettier --write . --ignore-path ../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../.prettierignore",
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build --output-dir storybook-static",
    "test-storybook": "vitest run --project storybook",
    "capture:design": "npm run build-storybook && node scripts/capture-design.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.3",
    "@storybook/addon-docs": "10.6.3",
    "@storybook/addon-vitest": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser": "^5.0.5",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "jsdom": "^30.1.3",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.88.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "storybook": "10.6.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
